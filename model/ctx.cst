// =======================================================
// model/ctx.cst — where every probability lives.
//
// This is the most load-bearing file in the repository, and it is load-bearing
// for a boring reason: the trainer and the codec both import it. A probability
// is only meaningful if the thing that counted it and the thing that spends it
// agree on which slot it is. If those two ever disagree the model is still a
// valid file, the codec still round-trips, and the compression quietly gets
// worse for reasons no test can localise. So the layout is here, once, and
// neither side is allowed its own copy of any of these numbers.
//
// The array is flat u16, indexed by a context number. Each region below is a
// base offset into it; a new region is added here and nowhere else.
//
// THE CHARACTER MODEL. Order-2, but not a full one. A true order-2 model over
// bytes is 65536 contexts of 256 tree slots — 33 MB of probabilities, sixteen
// times the entire Tiny budget, to model a string sixty bytes long. So the
// immediately preceding byte is kept whole, because in a URL it predicts an
// enormous amount ("t" after "h" after "t"), and the byte before that is
// reduced to one of eight classes. Which class a byte falls into is the part
// of it that still predicts at distance two: after a '/' the next-but-one byte
// behaves like the start of a path segment whichever letter it was.
//
// That gives 2048 contexts and just over a megabyte of probabilities, which
// leaves room inside Tiny for the dictionaries the grammar layer will want.
// =======================================================

// Eight classes for the byte at distance two. Everything a URL is made of that
// carries structural meaning gets its own; letters and digits share by case
// and kind, because at distance two that is all that survives.
let is i64 as NCLASS with imut = 8;

let is i64 as CLS_LOWER with imut = 0;
let is i64 as CLS_UPPER with imut = 1;
let is i64 as CLS_DIGIT with imut = 2;
let is i64 as CLS_SLASH with imut = 3;   // /
let is i64 as CLS_DOT   with imut = 4;   // .
let is i64 as CLS_DASH  with imut = 5;   // - _ ~
let is i64 as CLS_PUNCT with imut = 6;   // % ? & = # : + , ; @
let is i64 as CLS_OTHER with imut = 7;   // everything else, including non-ASCII

fn cls(c as i64) as i64 {
    if (c >= 97 && c <= 122) { return CLS_LOWER; }
    if (c >= 65 && c <= 90)  { return CLS_UPPER; }
    if (c >= 48 && c <= 57)  { return CLS_DIGIT; }
    if (c == 47) { return CLS_SLASH; }
    if (c == 46) { return CLS_DOT; }
    if (c == 45) { return CLS_DASH; }    // -
    if (c == 95) { return CLS_DASH; }    // _
    if (c == 126) { return CLS_DASH; }   // ~
    if (c == 37) { return CLS_PUNCT; }   // %
    if (c == 63) { return CLS_PUNCT; }   // ?
    if (c == 38) { return CLS_PUNCT; }   // &
    if (c == 61) { return CLS_PUNCT; }   // =
    if (c == 35) { return CLS_PUNCT; }   // #
    if (c == 58) { return CLS_PUNCT; }   // :
    if (c == 43) { return CLS_PUNCT; }   // +
    if (c == 44) { return CLS_PUNCT; }   // ,
    if (c == 59) { return CLS_PUNCT; }   // ;
    if (c == 64) { return CLS_PUNCT; }   // @
    return CLS_OTHER;
}

// ── region: the mode bit ─────────────────────────────────────────────
// One slot. Structural or raw. Only raw exists so far, so the trained
// probability will sit near certainty and cost almost nothing — which is the
// point of coding it now rather than adding it later and breaking the format.
let is i64 as CTX_MODE with imut = 0;
let is i64 as MODE_N   with imut = 1;

// ── region: the length ───────────────────────────────────────────────
// A four-bit tree over the bit-length of the URL, then that many raw low bits.
// Sixteen slots covers lengths up to MAX_URL with room to spare.
//
// An explicit length rather than a terminator symbol, and the reason is the
// redirect server rather than the ratio. The decoder is handed bytes chosen by
// whoever typed the link; a length it reads up front and bounds immediately
// cannot run away, where a terminator that never arrives can.
let is i64 as CTX_LEN  with imut = 1;
let is i64 as LEN_BITS with imut = 4;
let is i64 as LEN_N    with imut = 16;

// ── region: the character model ──────────────────────────────────────
let is i64 as CHAR_TREE with imut = 256;          // an 8-bit tree per context
let is i64 as CHAR_CTX  with imut = 2048;         // 256 previous bytes x NCLASS
let is i64 as CTX_CHAR  with imut = 17;           // CTX_LEN + LEN_N
let is i64 as CHAR_N    with imut = 524288;       // CHAR_CTX * CHAR_TREE

// ── region: the structural grammar ───────────────────────────────────
//
// Everything above models a URL as a string. Everything below models it as a
// URL. The split into components is where nearly all the redundancy actually
// lives: "https://" is eight bytes that carry about one bit, a host and a path
// have almost nothing in common statistically, and a query value is drawn from
// a different world again. Coding them through one character model asks it to
// be the average of six unrelated distributions, which is the worst possible
// answer to every one of them.
//
// The components tile the URL exactly — url_split guarantees that — so the
// structural reading is always reconstructible and never needs a fallback for
// correctness. Raw mode remains for what the splitter refuses at all.

let is i64 as COMP_SCHEME with imut = 0;
let is i64 as COMP_USER   with imut = 1;
let is i64 as COMP_HOST   with imut = 2;
let is i64 as COMP_PORT   with imut = 3;
let is i64 as COMP_PATH   with imut = 4;
let is i64 as COMP_QUERY  with imut = 5;
let is i64 as COMP_FRAG   with imut = 6;
let is i64 as NCOMP       with imut = 8;    // a power of two, one slot spare

// Structural flags, one probability each. They are single bits rather than a
// tree because they are independent: a URL having a port says little about it
// having a fragment, and a tree over the combination would spend its mass
// learning that.
let is i64 as SF_HTTPS with imut = 0;   // the scheme is exactly "https"
let is i64 as SF_HTTP  with imut = 1;   // ...or exactly "http", asked second
let is i64 as SF_SLASH with imut = 2;   // the "//" was there
let is i64 as SF_HOST  with imut = 3;
let is i64 as SF_USER  with imut = 4;
let is i64 as SF_PORT  with imut = 5;
let is i64 as SF_QUERY with imut = 6;
let is i64 as SF_FRAG  with imut = 7;
let is i64 as SFLAG_N  with imut = 8;

let is i64 as CTX_SFLAG with imut = 524305;    // CTX_CHAR + CHAR_N

// A length tree per component. A host is almost always 10-30 bytes and a
// fragment is almost always absent; one shared length model would learn
// neither.
let is i64 as CTX_SLEN with imut = 524313;     // CTX_SFLAG + SFLAG_N
let is i64 as SLEN_N   with imut = 128;        // NCOMP * LEN_N

// The structural character model: the previous byte, and which component we
// are inside. The same size as the raw model — 2048 contexts — but spending
// the second dimension on where we are rather than on what came two bytes ago.
// Inside a component the previous byte already carries most of the local
// correlation; what it cannot say is that this is a host rather than a path.
let is i64 as CTX_SCHAR with imut = 524441;    // CTX_SLEN + SLEN_N
let is i64 as SCHAR_N   with imut = 524288;    // NCOMP * 256 * CHAR_TREE

// ── region: the token dictionaries ───────────────────────────────────
//
// Four dictionaries, because measurement said four. On real browsing, a
// 4096-entry host dictionary covers 98.8% of host bytes and a 1024-entry key
// dictionary covers 94.8% of query-key bytes; those two components stop
// costing anything at all. Path segments come in at 37.9% and query values at
// 22.7% — worth having, and honest about the rest.
//
// A token is one hit bit, then its rank through a bit-length bucket. That
// costs about two bits for a common token and 2*log2(rank) for a rare one,
// which is the shape token frequency actually has. A miss costs the bit plus
// the token spelled out through its component's character model.

let is i64 as DICT_HOST with imut = 0;   // host labels, split on '.'
let is i64 as DICT_PATH with imut = 1;   // path segments, split on '/'
let is i64 as DICT_KEY  with imut = 2;   // query keys
let is i64 as DICT_VAL  with imut = 3;   // query values
let is i64 as NDICT     with imut = 4;

// A key is its own component in the character model: query keys are short,
// lowercase and drawn from a small world, and averaging them with the values
// beside them helped neither.
let is i64 as COMP_KEY with imut = 7;

let is i64 as RANK_BITS with imut = 5;    // bucket tree over the rank's bit-length
let is i64 as RANK_N    with imut = 32;

let is i64 as CTX_THIT with imut = 1048729;   // CTX_SCHAR + SCHAR_N; NDICT slots
let is i64 as CTX_TCNT with imut = 1048733;   // token counts, NDICT * LEN_N
let is i64 as TCNT_N   with imut = 64;
let is i64 as CTX_TRANK with imut = 1048797;  // NDICT * RANK_N
let is i64 as TRANK_N  with imut = 128;
let is i64 as CTX_HASVAL with imut = 1048925; // a query parameter carries '='

// The whole array.
let is i64 as NPROBS with imut = 1048926;

fn schar_base(prev as i64, comp as i64) as i64 {
    return CTX_SCHAR + ((prev * NCOMP) + comp) * CHAR_TREE;
}

fn slen_base(comp as i64) as i64 {
    return CTX_SLEN + comp * LEN_N;
}

fn tcnt_base(dictid as i64) as i64 {
    return CTX_TCNT + dictid * LEN_N;
}

fn trank_base(dictid as i64) as i64 {
    return CTX_TRANK + dictid * RANK_N;
}

// Sentinel for "there is no previous byte". 0 is safe: a NUL cannot appear in
// a URL that reached us as a NUL-terminated string, so the start-of-string
// context is never confused with a real one.
let is i64 as NOPREV with imut = 0;

// Base of the tree predicting the next byte, given the two before it.
fn char_base(p1 as i64, p2 as i64) as i64 {
    return CTX_CHAR + ((p1 * NCLASS) + cls(p2)) * CHAR_TREE;
}

// Number of significant bits in v. bitlen(0) is 0, bitlen(1) is 1,
// bitlen(8192) is 14 — which is why LEN_BITS is 4 and not 3.
fn bitlen(v as i64) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as x with mut = v;
    while (x > 0) { n = n + 1; x = x >> 1; }
    return n;
}

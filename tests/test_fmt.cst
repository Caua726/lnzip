// =======================================================
// tests/test_fmt.cst — the two output alphabets round-trip, and reject.
//
// Both are bit-repacking, which is the kind of code that works for every
// length someone tried by hand and fails on the one where the accumulator
// happens to straddle a boundary. So every length from 0 to 200 bytes is
// checked rather than a handful of interesting ones.
//
// The two have different contracts and the test says so. Base64URL is exact:
// n bytes in, n bytes out. Unicode may hand back one extra zero byte, because
// 14 and 8 share a factor and the padding bits round up to a whole one. That
// is not a defect to be worked around — the range decoder reads zeros off the
// end of its buffer by design — but it is a promise, so it is tested as one.
//
// The rejection cases matter as much as the round-trip. Both decoders run on
// request paths where the input is whatever arrived after the slash.
//
// Exit code is which check failed.
// =======================================================

use "../fmt/b64url.cst" as b64;
use "../fmt/uni.cst"    as uni;
use "../core/errno.cst" as errno;
use "std/io.cst"        as io;

let is i64 as _rs with mut = 2463534242;
fn rnd() as i64 {
    let is i64 as x with mut = _rs;
    x = x ^ ((x << 13) & 0x7FFFFFFFFFFFFFFF);
    x = x ^ ((x >> 7) & 0x00FFFFFFFFFFFFFF);
    x = x ^ ((x << 17) & 0x7FFFFFFFFFFFFFFF);
    if (x == 0) { x = 2463534242; }
    _rs = x;
    return x & 0x7FFFFFFFFFFFFFFF;
}

let is i64 as NMAX with imut = 200;

fn main() as i32 {
    let is [256]u8  as payload;
    let is [512]u8  as chars;
    let is [1024]u8 as utf8;
    let is [512]u8  as back;

    // ── every length, both alphabets ──────────────────────────────
    let is i64 as n with mut = 0;
    while (n <= NMAX) {
        let is i64 as i with mut = 0;
        while (i < n) { payload[i] = cast(u8, rnd() & 0xFF); i = i + 1; }

        // Base64URL: exact, both ways.
        let is i64 as c = b64.b64_encode(cast(*u8, &payload), n, cast(*u8, &chars), 512);
        if (c < 0)                  { return 1; }
        if (c != b64.b64_chars(n))  { return 2; }
        let is i64 as d = b64.b64_decode(cast(*u8, &chars), c, cast(*u8, &back), 512);
        if (d != n) { return 3; }
        i = 0;
        while (i < n) {
            if (back[i] != payload[i]) { return 4; }
            i = i + 1;
        }

        // Unicode: the original, then at most one zero byte.
        let is i64 as u = uni.uni_encode(cast(*u8, &payload), n, cast(*u8, &utf8), 1024);
        if (u < 0)                 { return 5; }
        if (u != uni.uni_size(n))  { return 6; }
        if (u != uni.uni_chars(n) * 3) { return 7; }
        let is i64 as ud = uni.uni_decode(cast(*u8, &utf8), u, cast(*u8, &back), 512);
        if (ud < n)     { return 8; }
        if (ud > n + 1) { return 9; }
        i = 0;
        while (i < n) {
            if (back[i] != payload[i]) { return 10; }
            i = i + 1;
        }
        // The extra byte, when there is one, is padding and must be zero: a
        // non-zero one would change what the range decoder reads.
        if (ud == n + 1) {
            if (back[n] != 0) { return 11; }
        }

        n = n + 1;
    }

    // ── the design's own arithmetic ───────────────────────────────
    // 96 bits is 12 bytes: sixteen Base64URL characters, seven CJK ones.
    if (b64.b64_chars(12) != 16) { return 20; }
    if (uni.uni_chars(12) != 7)  { return 21; }

    // ── an empty payload is empty, not one character of nothing ───
    if (b64.b64_encode(cast(*u8, &payload), 0, cast(*u8, &chars), 512) != 0) { return 22; }
    if (uni.uni_encode(cast(*u8, &payload), 0, cast(*u8, &utf8), 1024) != 0) { return 23; }
    if (b64.b64_decode(cast(*u8, &chars), 0, cast(*u8, &back), 512) != 0)    { return 24; }

    // ── base64: everything outside the alphabet is refused ────────
    let is i64 as ch with mut = 0;
    while (ch < 256) {
        chars[0] = cast(u8, 65);       // 'A', always legal
        chars[1] = cast(u8, ch);
        let is i64 as r = b64.b64_decode(cast(*u8, &chars), 2, cast(*u8, &back), 512);
        let is i64 as legal with mut = 0;
        if (ch >= 65 && ch <= 90)  { legal = 1; }
        if (ch >= 97 && ch <= 122) { legal = 1; }
        if (ch >= 48 && ch <= 57)  { legal = 1; }
        if (ch == 45) { legal = 1; }
        if (ch == 95) { legal = 1; }
        if (legal == 1) {
            if (r != 1) { return 30; }
        } else {
            if (r != errno.E_BADCHAR) { return 31; }
        }
        ch = ch + 1;
    }
    // '=' and '+' and '/' specifically: the three characters that make plain
    // Base64 unusable in a path, and the three someone will paste in by
    // mistake having copied from a different encoder.
    chars[0] = cast(u8, 61);
    if (b64.b64_decode(cast(*u8, &chars), 1, cast(*u8, &back), 512) != errno.E_BADCHAR) { return 32; }
    chars[0] = cast(u8, 43);
    if (b64.b64_decode(cast(*u8, &chars), 1, cast(*u8, &back), 512) != errno.E_BADCHAR) { return 33; }
    chars[0] = cast(u8, 47);
    if (b64.b64_decode(cast(*u8, &chars), 1, cast(*u8, &back), 512) != errno.E_BADCHAR) { return 34; }

    // ── unicode: shape, range and truncation are all refused ──────
    utf8[0] = cast(u8, 0xE4); utf8[1] = cast(u8, 0xB8); utf8[2] = cast(u8, 0x80);   // U+4E00
    if (uni.uni_decode(cast(*u8, &utf8), 3, cast(*u8, &back), 512) != 1) { return 40; }

    // A two-byte sequence: right idea, wrong length.
    utf8[0] = cast(u8, 0xC3); utf8[1] = cast(u8, 0xA9);
    if (uni.uni_decode(cast(*u8, &utf8), 2, cast(*u8, &back), 512) != errno.E_BADCHAR) { return 41; }

    // A three-byte sequence cut short.
    utf8[0] = cast(u8, 0xE4); utf8[1] = cast(u8, 0xB8);
    if (uni.uni_decode(cast(*u8, &utf8), 2, cast(*u8, &back), 512) != errno.E_BADCHAR) { return 42; }

    // A continuation byte that is not one.
    utf8[0] = cast(u8, 0xE4); utf8[1] = cast(u8, 0x38); utf8[2] = cast(u8, 0x80);
    if (uni.uni_decode(cast(*u8, &utf8), 3, cast(*u8, &back), 512) != errno.E_BADCHAR) { return 43; }

    // U+3042 (hiragana): valid UTF-8, below the alphabet.
    utf8[0] = cast(u8, 0xE3); utf8[1] = cast(u8, 0x81); utf8[2] = cast(u8, 0x82);
    if (uni.uni_decode(cast(*u8, &utf8), 3, cast(*u8, &back), 512) != errno.E_BADCHAR) { return 44; }

    // U+9FA5: a CJK ideograph, but past the 16384 this alphabet uses.
    utf8[0] = cast(u8, 0xE9); utf8[1] = cast(u8, 0xBE); utf8[2] = cast(u8, 0xA5);
    if (uni.uni_decode(cast(*u8, &utf8), 3, cast(*u8, &back), 512) != errno.E_BADCHAR) { return 45; }

    // ── a buffer too small is said so, not written past ───────────
    if (b64.b64_encode(cast(*u8, &payload), 100, cast(*u8, &chars), 4) != errno.E_SPACE)  { return 50; }
    if (uni.uni_encode(cast(*u8, &payload), 100, cast(*u8, &utf8), 4) != errno.E_SPACE)   { return 51; }
    let is i64 as cc = b64.b64_encode(cast(*u8, &payload), 100, cast(*u8, &chars), 512);
    if (b64.b64_decode(cast(*u8, &chars), cc, cast(*u8, &back), 4) != errno.E_SPACE)      { return 52; }

    io.write_str(io.STDOUT, "fmt: base64url exact and unicode zero-padded, 0..200 bytes\n");
    return 0;
}

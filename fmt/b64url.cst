// =======================================================
// fmt/b64url.cst — the payload as characters that survive a URL path.
//
// Base64URL, RFC 4648 §5, without padding: A-Z a-z 0-9 - _ and nothing else.
// Six bits a character, and every one of the sixty-four goes into a path
// segment unescaped, which is the entire requirement — the code is going to
// live at `domain/CODE`, and a character that needed percent-encoding would
// cost three characters to say one.
//
// No padding, because '=' is exactly such a character and the length is
// already implied: n bytes always come back from ceil(8n/6) characters. That
// identity holds for every n, since 6*ceil(8n/6) lands in [8n, 8n+5] and the
// decoder's floor(6c/8) can only be n.
//
// Nothing here is canonical, and it does not need to be. The last character
// may carry unused low bits, which the encoder writes as zero and the decoder
// ignores, so a handful of distinct codes decode to the same payload. For a
// resolver that is harmless: decoding is deterministic, which is the only
// property a link needs.
// =======================================================

use "../core/errno.cst" as errno;

// Returned from a function rather than held in a global, and that is not a
// style choice. The wasm backend does not initialise a global declared as a
// string literal — `let is *u8 as T with imut = "..."` leaves T pointing at
// its own slot instead of at the bytes, with or without `imut`, so every read
// comes back zero. A literal returned from a function is materialised
// correctly. The same shape is what the embedded model generator emits, for
// the same reason.
fn _alpha() as *u8 {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
}

// Character to value, by arithmetic rather than a table: a 256-byte lookup
// would need lazy initialisation and a heap, to save nothing measurable on
// strings this short.
fn _val(c as i64) as i64 {
    if (c >= 65 && c <= 90)  { return c - 65; }         // A-Z -> 0..25
    if (c >= 97 && c <= 122) { return c - 71; }         // a-z -> 26..51
    if (c >= 48 && c <= 57)  { return c + 4; }          // 0-9 -> 52..61
    if (c == 45) { return 62; }                         // -
    if (c == 95) { return 63; }                         // _
    return 0 - 1;
}

// Characters needed for n payload bytes.
fn b64_chars(n as i64) as i64 {
    return (n * 8 + 5) / 6;
}

// Payload bytes recoverable from c characters.
fn b64_bytes(c as i64) as i64 {
    return (c * 6) / 8;
}

fn b64_encode(src as *u8, n as i64, out as *u8, max as i64) as i64 {
    if (b64_chars(n) > max) { return errno.E_SPACE; }

    let is i64 as acc   with mut = 0;
    let is i64 as nbits with mut = 0;
    let is i64 as w     with mut = 0;
    let is i64 as i     with mut = 0;
    while (i < n) {
        acc = (acc << 8) | cast(i64, src[i]);
        nbits = nbits + 8;
        while (nbits >= 6) {
            out[w] = _alpha()[(acc >> (nbits - 6)) & 63];
            w = w + 1;
            nbits = nbits - 6;
        }
        i = i + 1;
    }
    if (nbits > 0) {
        out[w] = _alpha()[(acc << (6 - nbits)) & 63];
        w = w + 1;
    }
    return w;
}

fn b64_decode(src as *u8, n as i64, out as *u8, max as i64) as i64 {
    let is i64 as acc   with mut = 0;
    let is i64 as nbits with mut = 0;
    let is i64 as w     with mut = 0;
    let is i64 as i     with mut = 0;
    while (i < n) {
        let is i64 as v = _val(cast(i64, src[i]));
        if (v < 0) { return errno.E_BADCHAR; }
        acc = (acc << 6) | v;
        nbits = nbits + 6;
        if (nbits >= 8) {
            if (w >= max) { return errno.E_SPACE; }
            out[w] = cast(u8, (acc >> (nbits - 8)) & 0xFF);
            w = w + 1;
            nbits = nbits - 8;
        }
        i = i + 1;
    }
    return w;
}

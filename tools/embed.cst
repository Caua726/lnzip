// =======================================================
// tools/embed.cst — turn a model file into Caustic source.
//
//   caustic-mk build embed
//   ./build/embed models/tiny.lnzm wasm/model_embedded.cst
//
// The browser build has no filesystem, so the model has to travel inside the
// module. It travels deflated: a trained Tiny model is about a megabyte of
// which some ninety percent is the untouched prior — every context the corpus
// never visited sits at exactly one half — so zlib takes it to well under a
// tenth of that. The wasm inflates it once at start-up, using the inflate that
// is already in caustic-compact and already builds for wasm.
//
// The escaping is the house trick — bytes as \xNN in a string literal, four
// kilobytes a chunk — but held differently. caustic-compact keeps such tables
// in `*u8 with imut` globals, which works natively and does NOT work on wasm:
// that backend never initialises a global declared as a string literal, so the
// name ends up pointing at its own slot and every read comes back zero. The
// same literal returned from a function is materialised correctly on both, so
// each chunk is emitted as a function.
//
// The output is generated, not source: it is regenerated from the model
// whenever the model changes, and it is not tracked.
// =======================================================

use "../core/errno.cst" as errno;
use "caustic-compact/core/bytes.cst"   as cb;
use "caustic-compact/formats/zlib.cst" as zlib;
use "std/io.cst"  as io;
use "std/env.cst" as env;
use "std/mem.cst" only bins, core as mem;

let is *u8 as HEX with imut = "0123456789abcdef";
let is i64 as CHUNK with imut = 4096;

fn put(b as *cb.Bytes, s as *u8) as void {
    let is i64 as i with mut = 0;
    while (s[i] != 0) { cb.bytes_push(b, s[i]); i = i + 1; }
}

fn put_int(b as *cb.Bytes, v as i64) as void {
    if (v == 0) { cb.bytes_push(b, cast(u8, 48)); return; }
    let is [24]u8 as tmp;
    let is i64 as n with mut = 0;
    let is i64 as x with mut = v;
    while (x > 0) { tmp[n] = cast(u8, 48 + (x % 10)); n = n + 1; x = x / 10; }
    while (n > 0) { n = n - 1; cb.bytes_push(b, tmp[n]); }
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    if (env.argc() < 3) {
        io.write_str(io.STDERR, "usage: embed <model.lnzm> <out.cst>\n");
        return 2;
    }
    let is *u8 as inpath  = env.argv(1);
    let is *u8 as outpath = env.argv(2);

    let is i64 as size = io.file_size(inpath);
    if (size <= 0) { io.write_str(io.STDERR, "cannot size model\n"); return 3; }
    let is *u8 as raw = mem.core.mmap_anon(size);
    if (cast(i64, raw) <= 0) { return 3; }
    let is i64 as fd = io._open_read(inpath);
    if (fd < 0) { return 3; }
    let is i64 as got with mut = 0;
    while (got < size) {
        let is i64 as n = io._read_fd(fd, cast(*u8, cast(i64, raw) + got), size - got);
        if (n <= 0) { break; }
        got = got + n;
    }
    io._close_fd(fd);
    if (got != size) { return 3; }

    let is cb.Bytes as packed with mut = cb.bytes_new(size / 4);
    if (zlib.zlib_compress(raw, size, &packed, 9) < 0) {
        io.write_str(io.STDERR, "compress failed\n");
        return 3;
    }

    let is cb.Bytes as src with mut = cb.bytes_new(packed.len * 5 + 8192);

    put(&src, "// Generated by tools/embed.cst. Do not edit, and do not track.\n");
    put(&src, "//\n// A trained model, deflated, as Caustic source. See tools/embed.cst for why\n");
    put(&src, "// this shape: each chunk is a function because the wasm backend does not\n");
    put(&src, "// initialise a global declared as a string literal.\n\n");
    put(&src, "use \"caustic-compact/core/bytes.cst\"   as cb;\n");
    put(&src, "use \"caustic-compact/formats/zlib.cst\" as zlib;\n\n");
    put(&src, "let is i64 as PACKED_SIZE with imut = "); put_int(&src, packed.len); put(&src, ";\n");
    put(&src, "let is i64 as MODEL_SIZE  with imut = "); put_int(&src, size);       put(&src, ";\n\n");

    let is i64 as nchunk = (packed.len + CHUNK - 1) / CHUNK;
    let is i64 as c with mut = 0;
    while (c < nchunk) {
        let is i64 as from = c * CHUNK;
        let is i64 as to with mut = from + CHUNK;
        if (to > packed.len) { to = packed.len; }
        put(&src, "fn _P"); put_int(&src, c); put(&src, "() as *u8 { return \"");
        let is i64 as i with mut = from;
        while (i < to) {
            let is i64 as b = cast(i64, packed.ptr[i]);
            cb.bytes_push(&src, cast(u8, 92));           // backslash
            cb.bytes_push(&src, cast(u8, 120));          // x
            cb.bytes_push(&src, HEX[(b >> 4) & 15]);
            cb.bytes_push(&src, HEX[b & 15]);
            i = i + 1;
        }
        put(&src, "\"; }\n");
        c = c + 1;
    }

    put(&src, "\nlet is *u8 as _MODEL with mut;\n");
    put(&src, "let is i32 as _ready with mut = 0;\n\n");
    put(&src, "// The model bytes, inflated on first use. Returns 0 on failure.\n");
    put(&src, "fn model_bytes() as *u8 {\n");
    put(&src, "    if (_ready == 1) { return _MODEL; }\n");
    put(&src, "    let is cb.Bytes as packed with mut = cb.bytes_new(PACKED_SIZE);\n");
    c = 0;
    while (c < nchunk) {
        let is i64 as from = c * CHUNK;
        let is i64 as to with mut = from + CHUNK;
        if (to > packed.len) { to = packed.len; }
        put(&src, "    cb.bytes_append(&packed, _P"); put_int(&src, c); put(&src, "(), "); put_int(&src, to - from); put(&src, ");\n");
        c = c + 1;
    }
    put(&src, "    let is cb.Bytes as out with mut = cb.bytes_new(MODEL_SIZE);\n");
    put(&src, "    if (zlib.zlib_decompress(packed.ptr, packed.len, &out) < 0) { return cast(*u8, 0); }\n");
    put(&src, "    if (out.len != MODEL_SIZE) { return cast(*u8, 0); }\n");
    put(&src, "    cb.bytes_free(&packed);\n");
    put(&src, "    _MODEL = out.ptr;\n");
    put(&src, "    _ready = 1;\n");
    put(&src, "    return _MODEL;\n");
    put(&src, "}\n\n");
    put(&src, "fn model_size() as i64 { return MODEL_SIZE; }\n");

    let is i64 as w = io.write_file_atomic(outpath, src.ptr, src.len);
    if (w < 0) { io.write_str(io.STDERR, "write failed\n"); return 4; }

    io.write_str(io.STDOUT, "embed: "); io.write_int(io.STDOUT, size);
    io.write_str(io.STDOUT, " -> ");    io.write_int(io.STDOUT, packed.len);
    io.write_str(io.STDOUT, " packed (");
    io.write_int(io.STDOUT, (packed.len * 100) / size);
    io.write_str(io.STDOUT, "%) -> ");  io.write_int(io.STDOUT, src.len);
    io.write_str(io.STDOUT, " bytes of source in "); io.write_int(io.STDOUT, nchunk);
    io.write_str(io.STDOUT, " chunks -> "); io.write_str(io.STDOUT, outpath);
    io.write_str(io.STDOUT, "\n");
    return 0;
}

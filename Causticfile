name "lnzip"
version "0.1.0"
author "Cauã Alvarenga Neves"

// lnzip — build and test surface.
//
//   caustic-mk run test            every suite
//   caustic-mk run test-opt        the same, through the optimizing backend
//   caustic-mk run clean           build artifacts
//   caustic-mk run distclean       generated assembly and objects too
//
// caustic-compact supplies the entropy substrate: the LZMA binary range coder
// that entropy/rc.cst is derived from, the byte buffer, and — for the
// benchmark — gzip, Brotli, Zstd, LZMA2 and LZ4 to measure against. It is
// declared on the runner target, which is what makes caustic-mk clone it into
// .caustic/deps before any suite needs it, pinned to a tag.
//
// caustic-net is deliberately NOT declared here. Only the redirect server
// needs it, and it drags caustic-crypto in transitively; keeping it off the
// library target leaves the codec free of network dependencies, fuzzable on
// its own, and buildable for wasm32-wasi. It arrives with the server target.

env_default "OPT" "-O1"

// Project level rather than per-target: every target below now reaches the
// entropy substrate through codec/, and caustic-mk only passes --path to
// targets that declare a depend of their own.
depend "caustic-compact" in "https://github.com/Caua726/caustic-compact" tag "v0.1.0"

// ── Targets ──────────────────────────────────────────────────────────

target "run" {
    src "tests/run.cst"
    out "build/run"
}

// The corpus gate. Separate from the suite on purpose: the corpus is
// gigabytes and lives outside the repository, so a suite that depended on it
// would fail on a fresh clone for a reason unrelated to the code.
//
//   caustic-mk build corpus && ./build/corpus <file-of-urls>
target "corpus" {
    src "tools/corpus.cst"
    out "build/corpus"
    flags "-O1"
}

// The command line tool.
target "lnzip" {
    src "cli/main.cst"
    out "build/lnzip"
    flags "-O1"
}

// The trainer. Counts a corpus into a probability array and writes a model.
//
//   caustic-mk build train && ./build/train <corpus> <out.lnzm> [id] [tier]
target "train" {
    src "tools/train.cst"
    out "build/train"
    flags "-O1"
}

// The browser build. The wasm module, the model embedded in it, and a page
// that opens from file:// with no server: see wasm/lnzip_wasm.cst.
target "embed" {
    src "tools/embed.cst"
    out "build/embed"
    flags "-O1"
}

target "bundle" {
    src "tools/bundle.cst"
    out "build/bundle"
    flags "-O1"
}

script "web" {
    "caustic-mk build embed"
    "caustic-mk build bundle"
    "./build/embed models/enpt-tiny.lnzm wasm/model_embedded.cst"
    "caustic --target=wasm32-wasi --path .caustic/deps -q wasm/lnzip_wasm.cst -o build/lnzip.wasm"
    "cp web/index.html web/lnzip.js web/qr.js build/"
    "cp models/enpt2.lnzm build/standard.lnzm"
    "./build/bundle web/index.html build/lnzip.wasm build/lnzip.html"
    "mkdir -p build/site"
    "cp web/index.html web/lnzip.js web/qr.js web/_headers build/site/"
    "cp build/lnzip.wasm build/site/"
    "cp models/enpt2.lnzm build/site/standard.lnzm"
}

// ── Scripts ──────────────────────────────────────────────────────────

// `build run` rather than a bare `caustic`: the dependency is resolved by the
// build system, not by the script, so the clone happens once and the tag pin
// is honoured.
script "test" {
    "caustic-mk build run"
    "./build/run"
}

// The same suite through the optimizing backend, reported separately. "Passes
// at -O0, fails at -O1" names a compiler regression rather than an lnzip bug,
// and that distinction is worth a separate script.
script "test-opt" {
    "caustic-mk build run"
    "./build/run ${OPT}"
}

// The wasm boundary, checked with node. Optional and deliberately outside
// `run test`: a clone with no node still builds and still passes the suite.
script "web-test" {
    "caustic-mk run web"
    "node web/test.js build/lnzip.wasm"
}

script "clean" {
    "rm -rf .caustic build"
    "echo 'clean: build artifacts and resolved dependencies removed'"
}

script "distclean" {
    "caustic-mk run clean"
    "find . -name '*.cst.s' -delete"
    "find . -name '*.cst.s.o' -delete"
    "echo 'distclean: generated assembly and objects removed too'"
}

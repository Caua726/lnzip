// =======================================================
// cli/main.cst — lnzip, at the command line.
//
//   lnzip encode <url>   [-m model.lnzm] [-a alphabet] [-v]
//   lnzip decode <code>  [-m model.lnzm]
//   lnzip info           [-m model.lnzm]
//
//   -m  the model to code against; $LNZIP_MODEL otherwise; the built-in
//       uniform model as a last resort, which compresses nothing
//   -a  base32 | base64url | emoji | cjk   (-u is a synonym for cjk)
//   -v  report sizes on stderr
//
// decode takes no alphabet: three of the four say which they are by being
// themselves, and the fourth carries a marker.
//
// The model is not optional in any meaningful sense — a payload is only
// decodable against the model it was coded against, and the built-in one
// exists so the tool runs before a corpus does, not so anyone ships links made
// with it. Encoding against it says so on stderr.
// =======================================================

use "../core/errno.cst"  as errno;
use "../model/fmt.cst"   as model;
use "../model/ctx.cst"   as ctx;
use "../codec/codec.cst" as codec;
use "../fmt/alpha.cst"   as alpha;
use "../url/split.cst"   as us;
use "caustic-compact/core/bytes.cst" as cb;
use "std/io.cst"  as io;
use "std/env.cst" as env;
use "std/mem.cst" only bins, core as mem;

fn slen(s as *u8) as i64 {
    let is i64 as n with mut = 0;
    while (s[n] != 0) { n = n + 1; }
    return n;
}

fn streq(a as *u8, b as *u8) as i64 {
    let is i64 as i with mut = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    if (a[i] == 0 && b[i] == 0) { return 1; }
    return 0;
}

fn usage() as i32 {
    io.write_str(io.STDERR, "usage:\n");
    io.write_str(io.STDERR, "  lnzip encode <url>  [-m model.lnzm] [-a alphabet] [-v]\n");
    io.write_str(io.STDERR, "  lnzip decode <code> [-m model.lnzm]   (opens the model the code names)\n");
    io.write_str(io.STDERR, "  lnzip info          [-m model.lnzm]\n");
    io.write_str(io.STDERR, "\nalphabets: base32 (5 bits) base64url (6) emoji (10) cjk (14)\n");
    io.write_str(io.STDERR, "  -u is a synonym for -a cjk. decode detects the alphabet itself.\n");
    return 2;
}

fn fail(what as *u8, rc as i64) as i32 {
    io.write_str(io.STDERR, what);
    io.write_str(io.STDERR, ": ");
    io.write_str(io.STDERR, errno.err_name(rc));
    io.write_str(io.STDERR, "\n");
    return 1;
}

// Append a NUL-terminated string at `at`; returns the new end.
fn put(buf as *u8, at as i64, s as *u8) as i64 {
    let is i64 as p with mut = at;
    let is i64 as i with mut = 0;
    while (s[i] != 0) { buf[p] = s[i]; p = p + 1; i = i + 1; }
    buf[p] = cast(u8, 0);
    return p;
}

fn put_int(buf as *u8, at as i64, v as i64) as i64 {
    let is [24]u8 as tmp;
    let is i64 as n with mut = 0;
    let is i64 as x with mut = v;
    if (x == 0) { tmp[0] = cast(u8, 48); n = 1; }
    while (x > 0) { tmp[n] = cast(u8, 48 + x % 10); x = x / 10; n = n + 1; }
    let is i64 as p with mut = at;
    while (n > 0) { n = n - 1; buf[p] = tmp[n]; p = p + 1; }
    buf[p] = cast(u8, 0);
    return p;
}

// Open the model a code names, looking in `dir` for lnzip-<tier>-<id>.lnzm —
// the names models/MANIFEST publishes under. The id inside the file is checked
// too: a file name is a claim, the header is the fact. Returns 0 and fills
// `m`, or -1 if no file in `dir` is model `id`.
fn open_by_id(m as *model.Model, dir as *u8, id as i64, path as *u8) as i64 {
    let is i64 as t with mut = 0;
    while (t < 3) {
        let is i64 as p with mut = put(path, 0, dir);
        p = put(path, p, "/lnzip-");
        if (t == 0) { p = put(path, p, "tiny-"); }
        if (t == 1) { p = put(path, p, "standard-"); }
        if (t == 2) { p = put(path, p, "max-"); }
        p = put_int(path, p, id);
        p = put(path, p, ".lnzm");
        if (model.model_open(m, path) == 0) {
            if (m.model_id == id) { return 0; }
            model.model_free(m);
        }
        t = t + 1;
    }
    return 0 - 1;
}

fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    if (env.argc() < 2) { return usage(); }

    let is *u8 as cmd = env.argv(1);

    let is *u8 as mpath with mut = cast(*u8, 0);
    let is *u8 as arg   with mut = cast(*u8, 0);
    let is i64 as alph with mut = alpha.ALPHA_B64;
    let is i64 as verbose  with mut = 0;

    // Flat rather than a chain of nested elses: a flag per option and one
    // fallthrough for the positional argument. The nested form is where an
    // unbalanced brace hides.
    let is i64 as i with mut = 2;
    while (i < env.argc()) {
        let is *u8 as a = env.argv(i);
        let is i64 as handled with mut = 0;

        if (streq(a, "-m") == 1) {
            i = i + 1;
            if (i >= env.argc()) { return usage(); }
            mpath = env.argv(i);
            handled = 1;
        }
        if (streq(a, "-a") == 1) {
            i = i + 1;
            if (i >= env.argc()) { return usage(); }
            let is *u8 as nm = env.argv(i);
            let is i64 as k with mut = 0;
            let is i64 as found with mut = 0;
            while (k < alpha.NALPHA) {
                if (streq(nm, alpha.alpha_name(k)) == 1) { alph = k; found = 1; }
                k = k + 1;
            }
            if (found == 0) {
                io.write_str(io.STDERR, "unknown alphabet: ");
                io.write_str(io.STDERR, nm);
                io.write_str(io.STDERR, "  (base32 base64url emoji cjk)\n");
                return 2;
            }
            handled = 1;
        }
        if (streq(a, "-u") == 1) { alph = alpha.ALPHA_CJK; handled = 1; }
        if (streq(a, "-v") == 1) { verbose = 1; handled = 1; }

        if (handled == 0) {
            if (cast(i64, arg) != 0) { return usage(); }
            arg = a;
        }
        i = i + 1;
    }

    if (cast(i64, mpath) == 0) { mpath = env.getenv("LNZIP_MODEL"); }

    // ── open a model ──────────────────────────────────────────────
    // decode opens its model itself, once it knows which one the code names.
    let is i64 as decoding = streq(cmd, "decode");
    let is model.Model as m with mut;
    let is i64 as builtin with mut = 0;
    if (decoding == 1) {
        builtin = 0;
    } else if (cast(i64, mpath) != 0) {
        let is i64 as rc0 = model.model_open(&m, mpath);
        if (rc0 != 0) { return fail(mpath, rc0); }
    } else {
        if (model.model_builtin(&m) != 0) { return fail("built-in model", errno.E_OOM); }
        builtin = 1;
    }

    // ── info ──────────────────────────────────────────────────────
    if (streq(cmd, "info") == 1) {
        io.write_str(io.STDOUT, "model      ");
        if (builtin == 1) { io.write_str(io.STDOUT, "built-in (uniform, compresses nothing)\n"); }
        else { io.write_str(io.STDOUT, mpath); io.write_str(io.STDOUT, "\n"); }
        io.write_str(io.STDOUT, "format     "); io.write_int(io.STDOUT, m.fmt_ver);  io.write_str(io.STDOUT, "\n");
        io.write_str(io.STDOUT, "id         "); io.write_int(io.STDOUT, m.model_id); io.write_str(io.STDOUT, "\n");
        io.write_str(io.STDOUT, "tier       "); io.write_int(io.STDOUT, m.tier);     io.write_str(io.STDOUT, "\n");
        io.write_str(io.STDOUT, "bytes      "); io.write_int(io.STDOUT, m.size);     io.write_str(io.STDOUT, "\n");
        io.write_str(io.STDOUT, "contexts   "); io.write_int(io.STDOUT, m.nprobs);   io.write_str(io.STDOUT, "\n");
        if (builtin == 0) {
            io.write_str(io.STDOUT, "integrity  ");
            if (model.model_verify(&m) == 0) { io.write_str(io.STDOUT, "ok\n"); }
            else { io.write_str(io.STDOUT, "FAILED — this model has changed since it was written\n"); }
        }
        model.model_free(&m);
        return 0;
    }

    if (cast(i64, arg) == 0) { return usage(); }

    let is i64 as CAP with imut = 65536;
    let is *u8 as textbuf = mem.core.mmap_anon(CAP);
    if (cast(i64, textbuf) <= 0) { return fail("alloc", errno.E_OOM); }

    // ── encode ────────────────────────────────────────────────────
    if (streq(cmd, "encode") == 1) {
        if (builtin == 1) {
            io.write_str(io.STDERR,
                "warning: no model given, using the built-in uniform one — this compresses nothing\n");
        }
        let is i64 as n = slen(arg);
        let is cb.Bytes as pay with mut = cb.bytes_new(16384);
        let is i64 as w = codec.lnz_encode(arg, n, &m, &pay);
        if (w < 0) { return fail("encode", w); }

        let is i64 as c with mut = alpha.alpha_encode(alph, pay.ptr, pay.len, textbuf, CAP);
        if (c < 0) { return fail("encode", c); }

        // A payload can legitimately be empty: a URL the model predicts almost
        // perfectly carries under a bit of information, and the coder trims its
        // zero tail. An empty code is not a usable link, so one character of
        // zeros stands in — it decodes back to an empty payload, which is
        // exactly what the coder wants.
        if (c == 0) {
            let is [1]u8 as zero;
            zero[0] = cast(u8, 0);
            c = alpha.alpha_encode(alph, cast(*u8, &zero), 1, textbuf, CAP);
        }

        io.write_bytes(io.STDOUT, textbuf, c);
        io.write_str(io.STDOUT, "\n");

        if (verbose == 1) {
            io.write_str(io.STDERR, "url ");        io.write_int(io.STDERR, n);
            io.write_str(io.STDERR, " B -> payload "); io.write_int(io.STDERR, pay.len);
            io.write_str(io.STDERR, " B -> ");
            io.write_int(io.STDERR, alpha.alpha_symbols(alph, pay.len));
            io.write_str(io.STDERR, " "); io.write_str(io.STDERR, alpha.alpha_name(alph));
            io.write_str(io.STDERR, " symbols ("); io.write_int(io.STDERR, c);
            io.write_str(io.STDERR, " utf-8 bytes)\n");
        }

        cb.bytes_free(&pay);
        model.model_free(&m);
        return 0;
    }

    // ── decode ────────────────────────────────────────────────────
    if (streq(cmd, "decode") == 1) {
        let is i64 as n = slen(arg);
        let is *u8 as pay = mem.core.mmap_anon(CAP);
        if (cast(i64, pay) <= 0) { return fail("alloc", errno.E_OOM); }

        // Which alphabet, unless one was named: three of the four say so by
        // being themselves, and the fourth carries a marker.
        let is i64 as use_a with mut = alph;
        if (env.argc() > 0) {
            let is i64 as det = alpha.alpha_detect(arg, n);
            if (det >= 0) { use_a = det; }
        }
        let is i64 as pn = alpha.alpha_decode(use_a, arg, n, pay, CAP);
        if (pn < 0) { return fail("decode", pn); }

        // The code names its model; open that one. -m and $LNZIP_MODEL are used
        // when they are it, and otherwise only say where to look. The built-in
        // uniform model is never tried here: it shares id 0 with the published
        // tiny model, and decoding a tiny code against it returns garbage or an
        // error instead of the URL.
        let is i64 as want = codec.lnz_model_of(pay, pn);
        let is *u8 as path = mem.core.mmap_anon(4096);
        let is *u8 as dir  = mem.core.mmap_anon(4096);
        let is i64 as found with mut = 0 - 1;
        if (cast(i64, mpath) != 0) {
            if (model.model_open(&m, mpath) == 0) {
                if (m.model_id == want) { found = 0; }
                else { model.model_free(&m); }
            }
            if (found != 0) {
                // The directory the named model sits in.
                let is i64 as cut with mut = 0 - 1;
                let is i64 as k with mut = 0;
                while (mpath[k] != 0) { if (mpath[k] == 47) { cut = k; } k = k + 1; }
                if (cut < 0) { put(dir, 0, "."); }
                else { k = 0; while (k < cut) { dir[k] = mpath[k]; k = k + 1; } dir[cut] = cast(u8, 0); }
                found = open_by_id(&m, dir, want, path);
            }
        }
        if (found != 0) {
            let is *u8 as mdir = env.getenv("LNZIP_MODELS");
            if (cast(i64, mdir) != 0) { found = open_by_id(&m, mdir, want, path); }
        }
        if (found != 0) { found = open_by_id(&m, "models", want, path); }
        if (found != 0) {
            io.write_str(io.STDERR, "decode: this code was made with model ");
            io.write_int(io.STDERR, want);
            io.write_str(io.STDERR, ", and no lnzip-*-");
            io.write_int(io.STDERR, want);
            io.write_str(io.STDERR, ".lnzm was found next to -m, in $LNZIP_MODELS or in models/\n");
            io.write_str(io.STDERR, "        the published models: caustic-mk run models\n");
            return 1;
        }

        let is i64 as d = codec.lnz_decode(pay, pn, &m, textbuf, us.MAX_URL);
        if (d < 0) { return fail("decode", d); }

        io.write_bytes(io.STDOUT, textbuf, d);
        io.write_str(io.STDOUT, "\n");
        model.model_free(&m);
        return 0;
    }

    model.model_free(&m);
    return usage();
}
